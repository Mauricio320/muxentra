{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar extensión (sin depurador)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Depurar extensión",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
